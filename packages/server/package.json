  },
  "dependencies": {
    "@clave/content": "1.0.0",
    "@clave/engine": "1.0.0",
    "@hono/node-server": "2.0.10",
    "better-sqlite3": "12.11.1",
    "hono": "4.13.7",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/ws": "8.18.1"
  }
}
