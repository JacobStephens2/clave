{
  "name": "clave-partner-dance-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/content",
    "packages/engine",
    "packages/client",
    "packages/server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm run dev -w @clave/client\" \"npm run dev -w @clave/server\"",
    "play": "npm run play -w @clave/engine",
    "build": "npm run check:art && npm run build -w @clave/content && npm run build -w @clave/engine && npm run build -w @clave/client && npm run build -w @clave/server && npm run check:bundle",
    "build:test-deps": "npm run build -w @clave/content && npm run build -w @clave/engine",
    "test": "npm run build:test-deps && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write \"packages/**/*.{ts,tsx,css,json,html}\" \"scripts/**/*.ts\" \"*.{js,ts,json}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,css,json,html}\" \"scripts/**/*.ts\" \"*.{js,ts,json}\" \".github/**/*.yml\"",
    "check:content": "npm run check -w @clave/content",
    "check:art": "node scripts/check-card-art.mjs",
    "check:bundle": "tsx scripts/check-bundle-size.ts",
    "check:unity": "node scripts/validate-unity-project.mjs",
    "check:unity:csharp": "dotnet run --project unity/Verification/Clave.Engine.Verification.csproj"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "concurrently": "10.0.3",
    "eslint": "10.7.0",
    "fast-check": "4.9.0",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
