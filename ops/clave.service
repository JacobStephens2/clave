[Unit]
Description=Clave partner dance game
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clave
WorkingDirectory=/opt/clave/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=CLAVE_DB_PATH=/var/lib/clave/clave.sqlite
ExecStart=/usr/bin/node packages/server/dist/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/clave
UMask=0077

[Install]
WantedBy=multi-user.target
